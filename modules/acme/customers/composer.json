{
  "name": "acme/customers",
  "description": "Módulo de referência de clientes para Starter Kit",
  "type": "starterkit-module",
  "version": "1.0.0",
  "require": {
    "php": "~8.5.0",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": { "Acme\\Customers\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Acme\\Customers\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": { "providers": ["Acme\\Customers\\CustomersServiceProvider"] }
  }
}
