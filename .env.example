APP_NAME="Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
VITE_PORT=5173

LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=starterkit
DB_USERNAME=sail
DB_PASSWORD=password
DB_FORWARD_PORT=3307

SESSION_DRIVER=database
