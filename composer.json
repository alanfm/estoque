{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "starterkit/host",
    "type": "project",
    "require": {
        "php": "~8.5.0",
        "acme/customers": "^1.0",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.68",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/", "Starterkit\\ContractSample\\": "tests/Fixtures/Modules/Starterkit/ContractSample/src/", "Acme\\Inventory\\Tests\\": "modules/acme/inventory/tests/"}},
    "repositories": [
        {"type": "path", "url": "modules/*/*", "options": {"symlink": true}}
    ],
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "@php artisan test",
        "format:check": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
